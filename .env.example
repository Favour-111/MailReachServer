# --- Required ---
DATABASE_URL="postgresql://user@localhost:5432/mailreach"
JWT_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32  (64 hex chars, encrypts Gmail tokens)

# --- Google OAuth (console.cloud.google.com -> Credentials -> OAuth client, type "Web") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an "Authorised redirect URI" on the OAuth client in Google Cloud.
# Dev: Vite proxies /api so the callback goes through the client port.
# Prod: https://your-domain/api/gmail/callback (add it to the Google client too)
GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmail/callback

# --- Legacy Brevo sender: no longer used for sending; keep until Gmail sending is tested, then delete ---
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=

# --- App ---
PORT=4000
CLIENT_URL=http://localhost:5173
ALLOW_REGISTRATION=true   # set to false once your ~5 users have signed up
SEND_DELAY_MS=1000        # pause between emails (be gentle with Gmail)

# --- Attachment storage: leave S3_BUCKET empty to use local ./uploads ---
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=              # e.g. Cloudflare R2 / Backblaze / MinIO; empty for AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
